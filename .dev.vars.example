# Copy this file to .dev.vars and fill in your own values.
# Find them on rule34.xxx: My Account > Options > API Access Credentials
RULE34_API_KEY=
RULE34_USER_ID=

# e621 (login needed for images). API key: e621.net > Account > Manage API Access
E621_USERNAME=
E621_API_KEY=

# e6ai (same software as e621). API key: e6ai.net > Account > Manage API Access
E6AI_USERNAME=
E6AI_API_KEY=

# Danbooru (optional, anonymous works but allows only 2 tags per search). API key: danbooru.donmai.us > My Account > API Key
DANBOORU_USERNAME=
DANBOORU_API_KEY=

# Gelbooru (API key needed for the API). gelbooru.com > My Account > Options > API Access Credentials
GELBOORU_API_KEY=
GELBOORU_USER_ID=

# Derpibooru (optional, API key only). Key: derpibooru.org > Account > API key
DERPIBOORU_API_KEY=

# Sankaku (chan.sankakucomplex.com, optional; local server only). Your normal site login, no API key exists.
# Without it some posts come back without a file. Passwords with # or quotes can't be saved from Settings.
SANKAKU_USERNAME=
SANKAKU_PASSWORD=
